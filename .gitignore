node_modules/
data/players.json*
app/node_modules/
firebase/node_modules/
firebase/functions/node_modules/
*.pdf
.env
functions/.env
*.output

# Backups taken before destructive data passes (merges, re-crops). Local
# safety nets, not history.
*.bak-*
data/*.tmp

# Vite build output — regenerated by `npm run build`, and by stage 1 of the
# Dockerfile. Committing it just creates merge conflicts on every rebuild.
app/public/

# Emulator noise
firebase/firestore-debug.log
scripts/__pycache__/

# Desktop build output — 200MB+ of installers, rebuilt by `npm run dist:*`
# and published to Releases by the CI workflow.
dist-desktop/

# Practice session history is personal state, like players.json
data/sessions.json*

# Local editor/agent settings, not project config
.claude/
